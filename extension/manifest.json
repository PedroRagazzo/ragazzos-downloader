{
  "manifest_version": 3,
  "name": "Vídeo Downloader",
  "version": "0.1.0",
  "description": "Baixe vídeos e áudios do YouTube, TikTok, Instagram e Pinterest.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vídeo Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:47321/*"
  ],
  "key": ""
}
